extends RefCounted
## Animation-only extraction from uploaded "stylized+boy+3d+model (2).glb"
## Original clip: run.001, 65 bone quaternion channels, 16 sampled keys per
## bone (12fps interpolation); NO mesh, textures, material, or source character.
const COMPRESSED_RUN_BASE64: String = ""
static func read_motion() -> Dictionary:
	var compressed: PackedByteArray = Marshalls.base64_to_raw(COMPRESSED_RUN_BASE64)
	var uncompressed: PackedByteArray = compressed.decompress_dynamic(120000,FileAccess.COMPRESSION_GZIP)
	if uncompressed.is_empty():
		push_error("[LembahSari] Extracted Run animation data could not be decompressed")
		return {}
	var parsed: Variant = JSON.parse_string(uncompressed.get_string_from_utf8())
	if parsed is Dictionary:
		return parsed as Dictionary
	return {}
